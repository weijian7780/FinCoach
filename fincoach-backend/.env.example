# Copy to .env and fill in. NEVER commit the real .env.

# ---- Supabase (server-side) ----
# Project URL and the SERVICE ROLE key (Dashboard -> Project Settings -> API).
# The service role key is SECRET. Keep it only here, never in the mobile app.
SUPABASE_URL=https://yqsyrzdpvtasldkthhfg.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# ---- Embeddings ----
# bge-m3 = 1024 dims (must match vector(1024) in sql/knowledge.sql).
EMBEDDING_MODEL=BAAI/bge-m3

# ---- LLM (OpenAI-compatible) ----
# Leave blank to run with a stub and decide the provider later.
# Examples:
#   NVIDIA NIM: LLM_BASE_URL=https://integrate.api.nvidia.com/v1
#               LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
#   Groq:       LLM_BASE_URL=https://api.groq.com/openai/v1
#   Gemini:     LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

RETRIEVE_K=5
RETRIEVE_THRESHOLD=0.35
COACH_HISTORY_LIMIT=12
COACH_RATE_LIMIT_MINUTE=6
COACH_RATE_LIMIT_DAY=100
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=350

# Comma-separated browser origins. Leave empty for a native-app-only deployment.
CORS_ORIGINS=

# Receipt OCR
PADDLE_OCR_DETECTION_MODEL=PP-OCRv5_mobile_det
PADDLE_OCR_RECOGNITION_MODEL=en_PP-OCRv5_mobile_rec

# Gemini cleans PaddleOCR text only. Keep this key on FastAPI; never use EXPO_PUBLIC_*.
GEMINI_API_KEY=
GEMINI_RECEIPT_MODEL=gemini-3.1-flash-lite
