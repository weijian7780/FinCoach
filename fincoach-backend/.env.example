# Copy to .env and fill in. NEVER commit the real .env.

# ---- Supabase (server-side) ----
# Project URL and the SERVICE ROLE key (Dashboard -> Project Settings -> API).
# The service role key is SECRET. Keep it only here, never in the mobile app.
SUPABASE_URL=https://yqsyrzdpvtasldkthhfg.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# ---- Embeddings ----
# bge-m3 = 1024 dims (must match vector(1024) in sql/knowledge.sql).
EMBEDDING_MODEL=BAAI/bge-m3

# ---- LLM providers (OpenAI-compatible) ----
# The primary provider is attempted first. A failure automatically falls back to
# the existing LLM_* provider. Leave all three primary values blank to use only
# the fallback provider.
LLM_PRIMARY_BASE_URL=https://openrouter.ai/api/v1
LLM_PRIMARY_API_KEY=replace-with-a-rotated-openrouter-key
LLM_PRIMARY_MODEL=google/gemma-4-31b-it:free
LLM_PRIMARY_MAX_TOKENS=2048

# Direct DeepSeek V4 Flash fallback. Use a dedicated Coach key here; do not reuse
# GEMINI_API_KEY because that key remains reserved for receipt OCR cleanup.
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash

RETRIEVE_CANDIDATES=5
RETRIEVE_K=3
RETRIEVE_THRESHOLD=0.45
RETRIEVE_SCORE_MARGIN=0.10
COACH_HISTORY_LIMIT=6
COACH_HISTORY_CHAR_LIMIT=4000
COACH_RATE_LIMIT_MINUTE=6
COACH_RATE_LIMIT_DAY=100
# Safety default: Coaching stays advice/read-only until a deployment explicitly
# enables confirmation-gated reminder and report actions after acceptance testing.
COACH_WRITE_ACTIONS_ENABLED=false
LLM_TIMEOUT_SECONDS=25
COACH_REQUEST_DEADLINE_SECONDS=120
LLM_PRIMARY_TIMEOUT_SECONDS=110
LLM_FALLBACK_TIMEOUT_SECONDS=24
GROUNDING_VERIFIER_TIMEOUT_SECONDS=8
GROUNDING_VERIFIER_MAX_TOKENS=256
COACH_RATE_LIMIT_RETRY_MAX_SECONDS=3
# Research stages share COACH_REQUEST_DEADLINE_SECONDS; these are caps, not
# extra deadlines. Docker supplies the same two-minute contract.
COACH_STRUCTURED_TIMEOUT_SECONDS=15
COACH_RESEARCH_MAX_ROUNDS=3
COACH_RESEARCH_ANSWER_RESERVE_SECONDS=75
COACH_FINALIZATION_RESERVE_SECONDS=10
COACH_RESEARCH_PHASE_SECONDS=35
COACH_RESEARCH_INTERPRETATION_SECONDS=8
COACH_RESEARCH_WRITER_SECONDS=35
COACH_RESEARCH_CORRECTION_SECONDS=24
# Candidate ceiling; the live assessment pilot must approve 6 or 4 before release.
COACH_RESEARCH_FACT_BINDING_LIMIT=6
COACH_RESEARCH_MAX_ASSESSMENT_RETRIES=1
COACH_PUBLIC_SOURCE_CACHE_ENABLED=true
COACH_PUBLIC_SOURCE_CACHE_DIR=data/public-source-cache
COACH_PUBLIC_SOURCE_CACHE_TTL_SECONDS=86400
LLM_MAX_TOKENS=32768

# --- Evidence-validation / web-research fallback ---------------------------
# Rollback flag. "legacy" = the current grounding path, byte-for-byte. Flip to
# "evidence" ONLY after the Task 7 comparison shows it wins.
COACH_GROUNDING_MODE=legacy
# Verifier token budget used only in evidence mode (real extracted passages need
# more room than a snippet). Legacy keeps GROUNDING_VERIFIER_MAX_TOKENS=256.
GROUNDING_VERIFIER_EVIDENCE_MAX_TOKENS=1536
# Web-research fallback (fires only when the corpus can't answer a knowledge
# question). Needs a Tavily key AND `pip install tavily-python`; with no key the
# fallback yields nothing and the answer degrades to "insufficient evidence".
TAVILY_API_KEY=
WEB_FALLBACK_ENABLED=true
WEB_FALLBACK_SIM_THRESHOLD=0.45
WEB_FALLBACK_MAX_RESULTS=4
WEB_FALLBACK_TIMEOUT_SECONDS=8

# Comma-separated browser origins. Leave empty for a native-app-only deployment.
CORS_ORIGINS=

# Receipt OCR
PADDLE_OCR_DETECTION_MODEL=PP-OCRv5_mobile_det
PADDLE_OCR_RECOGNITION_MODEL=en_PP-OCRv5_mobile_rec
# Oracle ARM64: avoid the prebuilt wheel's crashing static AnalysisPredictor.
PADDLE_OCR_ENGINE=paddle_dynamic
# Bound 12 MP phone photos before CPU inference. Use a multiple of 32.
PADDLE_OCR_MAX_SIDE=1600
# Correct 0/90/180/270-degree documents before reconstructing receipt rows.
PADDLE_OCR_DOC_ORIENTATION=true
# Oracle Always Free Ampere instances provide up to four OCPUs.
PADDLE_OCR_CPU_THREADS=4
# Visual verification runs regardless of PaddleOCR confidence.

# Gemini extracts receipt fields from the image with supporting OCR. Server-side key only.
GEMINI_API_KEY=
GEMINI_RECEIPT_MODEL=gemini-3.5-flash-lite
# Shared image-verification and optional repair deadline; each request needs
# at least ten seconds remaining or the partial first response is retained.
RECEIPT_CLEANUP_TIMEOUT_SECONDS=30

# Enable together only after the reviewed admin migration and account setup.
ADMIN_PANEL_ENABLED=false
ACCOUNT_ACCESS_ENFORCED=false
# Supabase email identity behind the website username "admin".
ADMIN_LOGIN_EMAIL=
# Dockerfiles set /app/admin-static; empty uses the sibling frontend dist locally.
ADMIN_STATIC_DIR=
