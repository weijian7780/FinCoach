# Copy to .env and fill in. NEVER commit the real .env.

# ---- Supabase (server-side) ----
# Project URL and the SERVICE ROLE key (Dashboard -> Project Settings -> API).
# The service role key is SECRET. Keep it only here, never in the mobile app.
SUPABASE_URL=https://yqsyrzdpvtasldkthhfg.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ---- Embeddings ----
# bge-m3 = 1024 dims (must match vector(1024) in sql/knowledge.sql).
EMBEDDING_MODEL=BAAI/bge-m3

# ---- LLM (OpenAI-compatible) ----
# Leave blank to run with a stub and decide the provider later.
# Examples:
#   NVIDIA NIM: LLM_BASE_URL=https://integrate.api.nvidia.com/v1
#               LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
#   Groq:       LLM_BASE_URL=https://api.groq.com/openai/v1
#   Gemini:     LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

RETRIEVE_K=5
