{
  "_meta": {
    "purpose": "Development set for Jev multi-label ACTION detection + topic detection. Labels are human ground truth, written BEFORE querying Jev. Do not tune on the frozen test set.",
    "action_vocabulary": [
      "get_spending_summary", "get_budget_status", "get_savings_goals",
      "get_weekly_savings_plan", "predict_savings", "get_cashflow_forecast",
      "get_financial_overview", "get_financial_profile", "get_upcoming_reminders",
      "search_transactions", "prepare_reminder", "prepare_report",
      "education", "casual"
    ],
    "fields": {
      "expected_actions": "set of accepted tasks FinCoach must deliver (from action_vocabulary)",
      "expected_topics": "knowledge topic_ids that are substantive subjects (parent/child sets allowed)",
      "requires_personal_records": "true if any owner-scoped personal read/calc is needed",
      "expected_clarification": "true if the action itself is ambiguous or a required param is missing that fallback cannot resolve"
    },
    "paraphrase_groups": "cases sharing a pg_* tag are near-duplicates; keep them on the same side of any dev/test split",
    "finalized_labeling_rules": {
      "budget_allocation": "'how should I split/allocate my budget' = education only (per routing.py _BUDGET_ALLOCATION_QUERY, which routes allocation-method questions to FINANCIAL_EDUCATION, not get_budget_status). requires_personal_records=false.",
      "ptptn_vs_student_aid": "PTPTN questions are labelled ['ptptn'] ONLY. student_aid is a separate corpus doc (scholarships/biasiswa, official_student_financial_aid_and_scholarships.md) and the deterministic detector fires only ptptn for 'PTPTN'. Jev additionally firing student_aid on a PTPTN question is counted as a real topic-precision cost, NOT absorbed by relabelling (do not relabel extra predictions as correct)."
    }
  },
