EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
EXPO_PUBLIC_GOOGLE_AUTH_WEB_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com
# Physical Android phone: use the PC's LAN IP, not localhost.
# Use the deployed HTTPS API URL for production. Never add LLM or service-role keys here.
EXPO_PUBLIC_FINCOACH_API_URL=http://192.168.1.100:8000

# Supabase Edge Function secrets. Server-side only: never add EXPO_PUBLIC_.
# Set these with `npx supabase secrets set`; do not put real values in a mobile build.
ALERT_WEBHOOK_SECRET=generate-a-long-random-secret
ALERT_CRON_SECRET=generate-a-different-long-random-secret
# Optional when Expo Push Service access-token security is enabled.
EXPO_ACCESS_TOKEN=optional-expo-push-access-token
